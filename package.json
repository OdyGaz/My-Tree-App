{
  "name": "electron-tree-app",
  "version": "1.0.0",
  "description": "An Electron application for creating interactive trees.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "keywords": [
    "Electron",
    "Tree",
    "Visualization",
    "D3"
  ],
  "author": "ody",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "build": {
    "appId": "com.ody.treeapp",
    "productName": "My Tree Application",
    "files": [
      "**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
